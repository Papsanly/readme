#import "template/main.typ": diploma
#import "data.typ": *

#show: diploma

#set page(numbering: none)
#set par(
  justify: true,
  first-line-indent: (amount: 1.25cm, all: true),
  leading: 1.2em,
  spacing: 1.2em,
)

#let author-instrumental = "Лисенком Андрієм Юрійовичем"
#let review-score = "відмінно"
#let signature-line(width) = box(
  width: width,
  height: 1em,
  outset: (bottom: 4pt),
  stroke: (bottom: 0.5pt + black),
)

#[
  #set par(first-line-indent: 0em, justify: false)

  #align(center)[*РЕЦЕНЗІЯ*]

  #align(center)[на дипломний проєкт]

  #align(center)[на здобуття ступеня бакалавра,]

  виконаний на тему: "#text(weight: "bold")[#title]"

  студентом групи #group #text(weight: "bold")[#author-instrumental]
]

#v(1.2em)

Поданий на рецензування дипломний проєкт містить 69 аркушів тексту, 6 ілюстрацій, 37 таблиць, 1 додаток. Робота відповідає затвердженій темі та є актуальною, оскільки зростання обсягів електронних документів, наукових статей, сканованих матеріалів і навчальної літератури створює потребу в інструментах, які не лише перетворюють текст на мовлення, а й коректно враховують структуру документа. Обрана тема має практичне значення та поєднує мобільну розробку, обробку документів, OCR/VLM-підхід і синтез мовлення.

У дипломному проєкті проаналізовано предметну область та існуючі програмні рішення, визначено функціональні й нефункціональні вимоги, описано сценарії використання системи. Автором спроєктовано архітектуру мобільного застосунку ReadMe та пов'язаних серверних компонентів, обґрунтовано використання vision-language моделі як семантичного шару між OCR-розміткою документа та TTS-синтезом. Пояснювальна записка викладена логічно й послідовно: від аналізу проблеми і постановки вимог до опису конструкції програмного забезпечення, тестування, розгортання та користувацьких сценаріїв.

Перевагою роботи вважаю практичну спрямованість розробки: реалізовано мобільний застосунок з імпортом документів різних форматів, бібліотекою, режимами перегляду original/reflowed, налаштуваннями голосу та швидкості, офлайн-завантаженням і резервним копіюванням. Окремо слід відзначити VLM-centric pipeline для семантичної підготовки тексту до озвучення, що дає змогу відфільтровувати службові елементи сторінки та підвищувати природність відтворення порівняно з прямим озвученням OCR-тексту.

До недоліків можна віднести те, що експериментальна оцінка якості згенерованого аудіо, затримок обробки та вартості інференсу могла б бути подана ширше: з більшим набором тестових документів, порівнянням із кількома альтернативними пайплайнами та кількісними метриками для різних форматів вхідних даних. Також доцільно було б детальніше описати обмеження, пов'язані з використанням зовнішніх AI/TTS-сервісів, зокрема питання конфіденційності документів користувача та залежності від доступності сторонніх API. Зазначені недоліки не знижують загальної цінності роботи та можуть бути враховані під час подальшого розвитку проєкту.

У цілому дипломний проєкт відповідає вимогам університету до дипломних проєктів, має завершений практичний результат і демонструє достатній рівень інженерної підготовки автора. Вважаю, що дипломний проєкт заслуговує оцінки "#text(weight: "bold")[#review-score]", а його автор — студент #author-full — заслуговує присудження ступеня бакалавра зі спеціальності "#speciality" та кваліфікації бакалавра з інженерії програмного забезпечення.

#v(1fr)

#{
  set par(first-line-indent: 0em, justify: false, spacing: 0.6em)

  [Рецензент]

  v(1.1em)

  grid(
    columns: (7.3cm, 3.8cm, 5.2cm),
    column-gutter: 0.35cm,
    reviewer-position, signature-line(3.8cm), reviewer-name,
  )
}

<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:signal id="Signal_BookReady" name="Книга готова (перша сторінка зафіксована)" />
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Main" name="Мобільний застосунок ReadMe" processRef="Process_Main" />
    <bpmn:participant id="Participant_Marker" name="datalab.to (Marker)" />
    <bpmn:participant id="Participant_VLM" name="VLM (Claude Sonnet)" />
    <bpmn:participant id="Participant_TTS" name="ElevenLabs / Kokoro" />
    <bpmn:messageFlow id="Msg_M1_Out" sourceRef="Task_AnalyzeFirstPage" targetRef="Participant_Marker" />
    <bpmn:messageFlow id="Msg_M1_In" sourceRef="Participant_Marker" targetRef="Task_AnalyzeFirstPage" />
    <bpmn:messageFlow id="Msg_V1_Out" sourceRef="Task_AnalyzeFirstPage" targetRef="Participant_VLM" />
    <bpmn:messageFlow id="Msg_V1_In" sourceRef="Participant_VLM" targetRef="Task_AnalyzeFirstPage" />
    <bpmn:messageFlow id="Msg_M2_Out" sourceRef="Task_AnalyzeRest" targetRef="Participant_Marker" />
    <bpmn:messageFlow id="Msg_M2_In" sourceRef="Participant_Marker" targetRef="Task_AnalyzeRest" />
    <bpmn:messageFlow id="Msg_V2_Out" sourceRef="Task_AnalyzeRest" targetRef="Participant_VLM" />
    <bpmn:messageFlow id="Msg_V2_In" sourceRef="Participant_VLM" targetRef="Task_AnalyzeRest" />
    <bpmn:messageFlow id="Msg_T_Out" sourceRef="Task_PlayBlock" targetRef="Participant_TTS" />
    <bpmn:messageFlow id="Msg_T_In" sourceRef="Participant_TTS" targetRef="Task_PlayBlock" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Main" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_User" name="Користувач">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Upload</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_UI" name="Мобільний застосунок (UI)">
        <bpmn:flowNodeRef>Task_Store</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Init</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Pipeline" name="Pipeline (фоновий потік)">
        <bpmn:flowNodeRef>Task_Segment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Image</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Render</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnalyzeFirstPage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ThrowEvent_BookReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnalyzeRest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_PipelineDone</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Player" name="Player (фоновий потік)">
        <bpmn:flowNodeRef>CatchEvent_BookReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PlayBlock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HasNext</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_PlayerDone</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_1" name="Початок" />
    <bpmn:userTask id="Task_Upload" name="Завантажує документ (файл / URL)" />
    <bpmn:task id="Task_Store" name="Зберігає у локальній бібліотеці" />
    <bpmn:task id="Task_Init" name="Ініціює streaming-обробку" />
    <bpmn:parallelGateway id="Gateway_Split" />

    <bpmn:task id="Task_Segment" name="Сегментує документ на сторінки" />
    <bpmn:exclusiveGateway id="Gateway_Image" name="Image-based?" />
    <bpmn:task id="Task_Render" name="Рендерить PDF→PNG (pdf.js у WebView)" />
    <bpmn:exclusiveGateway id="Gateway_Merge" />
    <bpmn:serviceTask id="Task_AnalyzeFirstPage" name="Аналіз сторінки 1: Marker + VLM (з ocrBlocks), commit блоків" />
    <bpmn:intermediateThrowEvent id="ThrowEvent_BookReady" name="Книга готова">
      <bpmn:signalEventDefinition signalRef="Signal_BookReady" />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="Task_AnalyzeRest" name="Аналіз решти сторінок: Marker + VLM (паралельно до 2 одночасно, commit у порядку сторінок)">
      <bpmn:multiInstanceLoopCharacteristics isSequential="false" />
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_PipelineDone" name="Обробку завершено" />

    <bpmn:intermediateCatchEvent id="CatchEvent_BookReady" name="Очікує сигнал «Книга готова»">
      <bpmn:signalEventDefinition signalRef="Signal_BookReady" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_PlayBlock" name="Синтез TTS поточного блоку (on-demand) + prefetch наступних, кешування у локальне сховище, відтворення" />
    <bpmn:exclusiveGateway id="Gateway_HasNext" name="Є наступний блок?" />
    <bpmn:endEvent id="EndEvent_PlayerDone" name="Відтворення завершено" />

    <bpmn:parallelGateway id="Gateway_Join" />
    <bpmn:endEvent id="EndEvent_1" name="Кінець" />

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_Upload" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Upload" targetRef="Task_Store" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Store" targetRef="Task_Init" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Init" targetRef="Gateway_Split" />

    <bpmn:sequenceFlow id="Flow_5" sourceRef="Gateway_Split" targetRef="Task_Segment" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Segment" targetRef="Gateway_Image" />
    <bpmn:sequenceFlow id="Flow_7_Yes" sourceRef="Gateway_Image" targetRef="Task_Render" name="так" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_Render" targetRef="Gateway_Merge" />
    <bpmn:sequenceFlow id="Flow_9_No" sourceRef="Gateway_Image" targetRef="Gateway_Merge" name="ні (txt/html)" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Gateway_Merge" targetRef="Task_AnalyzeFirstPage" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_AnalyzeFirstPage" targetRef="ThrowEvent_BookReady" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="ThrowEvent_BookReady" targetRef="Task_AnalyzeRest" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_AnalyzeRest" targetRef="EndEvent_PipelineDone" />

    <bpmn:sequenceFlow id="Flow_14" sourceRef="Gateway_Split" targetRef="CatchEvent_BookReady" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="CatchEvent_BookReady" targetRef="Task_PlayBlock" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_PlayBlock" targetRef="Gateway_HasNext" />
    <bpmn:sequenceFlow id="Flow_17_Yes" sourceRef="Gateway_HasNext" targetRef="Task_PlayBlock" name="так" />
    <bpmn:sequenceFlow id="Flow_18_No" sourceRef="Gateway_HasNext" targetRef="EndEvent_PlayerDone" name="ні / стоп користувача" />

    <bpmn:sequenceFlow id="Flow_19" sourceRef="EndEvent_PipelineDone" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="EndEvent_PlayerDone" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Gateway_Join" targetRef="EndEvent_1" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_Main_di" bpmnElement="Participant_Main" isHorizontal="true">

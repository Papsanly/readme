@startuml
skinparam packageStyle rectangle
skinparam shadowing false
skinparam usecaseBackgroundColor #FEFEFE
skinparam actorBackgroundColor #FEFEFE
skinparam packageBackgroundColor #F8F8F8
left to right direction

actor "Користувач" as User

rectangle "Мобільний застосунок ReadMe" {
  package "Бібліотека" {
    usecase "UC-01\nЗавантаження документа\nз файлової системи" as UC01
    usecase "UC-02\nЗавантаження документа\nза URL" as UC02
    usecase "UC-03\nПерегляд бібліотеки книг" as UC03
    usecase "UC-14\nЕкспорт і імпорт\nбібліотеки" as UC14
  }
  package "Плеєр" {
    usecase "UC-04\nПрослуховування\nдокумента" as UC04
    usecase "UC-06\nПеремикання reflowed/\noriginal view" as UC06
    usecase "UC-10\nТаймер сну" as UC10
    usecase "UC-11\nНавігація змістом\nкниги" as UC11
    usecase "UC-12\nШвидкий перехід до\nосновного контенту" as UC12
  }
  package "Налаштування" {
    usecase "UC-05\nНалаштування голосу\nта швидкості" as UC05
    usecase "UC-07\nНалаштування режиму\nпропуску блоків" as UC07
    usecase "UC-13\nОффлайн-завантаження\nкниги" as UC13
    usecase "UC-15\nНалаштування на\nрівні книги" as UC15
  }
  package "Акаунт" {
    usecase "UC-08\nРеєстрація та вхід\nв акаунт" as UC08
    usecase "UC-09\nУправління підпискою" as UC09
  }
}

User -- UC01
User -- UC02
User -- UC03
User -- UC04
User -- UC05
User -- UC06
User -- UC07
User -- UC08
User -- UC09
User -- UC10
User -- UC11
User -- UC12
User -- UC13
User -- UC14
User -- UC15

UC06 ..> UC04 : <<extend>>
UC05 ..> UC04 : <<extend>>
UC07 ..> UC04 : <<extend>>
UC10 ..> UC04 : <<extend>>
UC11 ..> UC04 : <<extend>>
UC12 ..> UC04 : <<extend>>
UC15 ..> UC04 : <<extend>>
UC13 ..> UC15 : <<extend>>
UC09 ..> UC08 : <<include>>
@enduml

#{
  set heading(numbering: none)
  heading(level: 1)[Перелік умовних позначень]
}

#table(
  columns: (auto, 1fr),
  stroke: none,
  inset: (x: 0.4em, y: 0.4em),
  [VLM], [Vision-Language Model — мультимодальна модель, що приймає на вхід зображення і текст та видає текстовий вихід.],
  [LLM], [Large Language Model — велика мовна модель.],
  [TTS], [Text-to-Speech — синтез мови з тексту.],
  [STT], [Speech-to-Text — розпізнавання мови.],
  [OCR], [Optical Character Recognition — оптичне розпізнавання символів.],
  [API], [Application Programming Interface — програмний інтерфейс застосунку.],
  [SDK], [Software Development Kit — набір інструментів розробника.],
  [IDE], [Integrated Development Environment — інтегроване середовище розробки.],
  [JSON], [JavaScript Object Notation — текстовий формат обміну даними.],
  [BPMN], [Business Process Model and Notation — нотація моделювання бізнес-процесів.],
  [UML], [Unified Modeling Language — уніфікована мова моделювання.],
  [UC], [Use Case — варіант використання.],
  [FR], [Functional Requirement — функціональна вимога.],
  [CI/CD], [Continuous Integration / Continuous Delivery — безперервна інтеграція та доставка.],
  [LoRA], [Low-Rank Adaptation — метод параметро-ефективного дотренування великих моделей.],
  [bbox], [bounding box — обмежувальна рамка для блоку на сторінці документа.],
  [ПЗ], [Програмне забезпечення.],
  [ШІ], [Штучний інтелект.],
  [ОС], [Операційна система.],
  [ДП], [Дипломний проєкт.],
  [ТЗ], [Технічне завдання.],
)
